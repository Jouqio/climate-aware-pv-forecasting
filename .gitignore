# ============================================================
# .gitignore — climate-aware-pv-forecasting
# Disesuaikan dengan struktur 10-notebook pipeline
# ============================================================

# ── Python bytecode ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# ── Virtual environments ─────────────────────────────────────
venv/
.venv/
env/
ENV/
.env
.env.local
.env.*.local

# ── Jupyter Notebook ─────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Legacy single-site scratch data (dibuat oleh NB01–NB03 saat PV_LOCATION unset) ──
# Hanya ignore notebooks/data/, BUKAN data/raw/ (raw NASA POWER source,
# HARUS ter-track) atau results/<site>/data/ (intermediate parquet,
# TIDAK di-track tapi lewat rule terpisah di bawah).
/notebooks/data/
!/notebooks/data/.gitkeep

# ── Per-site intermediate parquet (regeneratable via NB01-03) ────────
# HANYA results/*/data/, BUKAN data/raw/ (source CSVs, harus tetap
# ter-track) atau results/combined/ (tidak match pola ini).
results/*/data/

# ── Legacy single-site scratch outputs (dibuat oleh NB04–NB09 saat PV_LOCATION unset) ──
# Hanya ignore notebooks/outputs/, BUKAN results/<site>/outputs/ (hasil
# numerik per-lokasi, HARUS ter-track) atau results/combined/.
/notebooks/outputs/
!/notebooks/outputs/.gitkeep

# ── Legacy single-site figures (dibuat oleh NB10 saat PV_LOCATION unset) ──
# Hanya ignore notebooks/figures/, BUKAN results/<site>/figures/ atau
# results/combined/figures/ — kedua yang terakhir ini adalah hasil
# publikasi yang harus tetap ter-track di git.
/notebooks/figures/
!/notebooks/figures/.gitkeep

# ── Saved models (dibuat oleh NB07) ──────────────────────────
*.pkl
*.joblib
*.pt
*.pth

# ── Raw NASA POWER data ───────────────────────────────────────
# File ini sudah ter-commit, tambahkan ke .gitignore
# untuk mencegah versi baru ter-commit secara tidak sengaja
POWER_Point_Monthly_*.csv

# ── Data format lain ──────────────────────────────────────────
*.parquet
*.feather
*.hdf
*.h5

# ── ONI / DMI external data (NB03 mentions download) ─────────
oni.ascii.txt
dmi_*.csv
enso_*.csv

# ── Log files ─────────────────────────────────────────────────
*.log
*.out
logs/

# ── Secrets / config lokal ────────────────────────────────────
.env
*.secret
config_local.py

# ── OS & editor ───────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ── Build / packaging ─────────────────────────────────────────
dist/
build/
*.egg-info/
.eggs/
*.egg
